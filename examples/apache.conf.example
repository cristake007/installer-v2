# Operator example: enable proxy/proxy_fcgi; configure DNS/HTTPS yourself.
<VirtualHost *:80>
    ServerName example.com
    DocumentRoot /opt/fluidweb/data/public
    DirectoryIndex index.php
    <Directory /opt/fluidweb/data/public>
        Require all granted
        AllowOverride None
        Options -Indexes -FollowSymLinks
        <FilesMatch "\.php$">
            SetHandler "proxy:fcgi://127.0.0.1:9080"
        </FilesMatch>
    </Directory>
    <LocationMatch "(^|/)\.">
        Require all denied
    </LocationMatch>
    ProxyFCGISetEnvIf "true" SCRIPT_FILENAME "/var/www/html/public%{reqenv:SCRIPT_NAME}"
</VirtualHost>
