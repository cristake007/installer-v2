# EXAMPLE ONLY: the installer never modifies or reloads the host Apache.
# Required modules: proxy, proxy_fcgi, rewrite. Set DNS/TLS separately.
<VirtualHost *:80>
    ServerName example.com
    DocumentRoot /opt/fluidweb/data/public
    <Directory /opt/fluidweb/data/public>
        Require all granted
        AllowOverride None
        Options -Indexes -MultiViews +FollowSymLinks
        FallbackResource /index.php
    </Directory>
    <FilesMatch "^index\.php$">
        SetHandler "proxy:fcgi://127.0.0.1:9080/var/www/html/public/"
    </FilesMatch>
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
</VirtualHost>
