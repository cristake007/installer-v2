# EXAMPLE ONLY: the installer never modifies or reloads the host Nginx.
# Replace example.com and verify installation directory / port.
server {
    listen 80;
    server_name example.com;
    root /opt/fluidweb/data/public;
    index index.php;

    location = /health {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/health.php;
        fastcgi_pass 127.0.0.1:9080;
    }
    location / { try_files $uri /index.php$is_args$args; }
    location ~ ^/index\.php(/|$) {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_pass 127.0.0.1:9080;
        internal;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
